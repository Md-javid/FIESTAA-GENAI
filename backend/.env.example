# 
# MediCode AI — Backend Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp backend/.env.example backend/.env   (Linux/Mac)
#   copy backend\.env.example backend\.env  (Windows)
#
# Get a free Gemini API key: https://aistudio.google.com/app/apikey
# 

#  Required: Google Gemini API 
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

#  Django Core 
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-django-secret-key-change-in-production

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

#  CORS Origins 
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

#  Database (leave blank to use SQLite for local dev) 
# DATABASE_URL=postgresql://user:password@host:5432/medicode
