# Frontend .dockerignore
# Exclude files that should NOT be copied into the Docker build context

# Version control
.git/
.gitignore

# Environment files
.env
.env.*
.env.local

# Heavy artifacts — npm ci inside Dockerfile handles this
node_modules/
npm-debug.log*

# Previous builds (Dockerfile will run its own)
dist/

# OS artifacts
.DS_Store
Thumbs.db

# Editor configs
.vscode/
.idea/
*.swp
*.swo

# Documentation
README.md
